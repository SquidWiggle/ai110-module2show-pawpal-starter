classDiagram
    direction LR

    class Owner {
        +String name
        +List~Pet~ pets
        +TimeSlot available_time
        +schedule_task(task_type)
        +add_pet(pet: Pet)
        +feed_pet(pet: Pet)
        +play_with_pet(pet: Pet)
    }

    class Pet {
        +String name
        +String species
        +String breed
        +List~TaskType~ required_care
    }

    class Task {
        +DateTime due_date
        +Priority priority
        +TaskType type
        +Pet pet
        +int duration
        +Recurrence recurrence
        +execute()
    }

    class Scheduler {
        +List~Task~ tasks
        +schedule_task(task: Task)
        +see_todays_tasks() List~Task~
        +alert_conflict()
        +suggest_time_slot() TimeSlot
    }

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    class TaskType {
        <<enumeration>>
        FEEDINGS
        WALKS
        MEDICATIONS
        VET_APPOINTMENT
        PLAY
        GROOMING
    }

    class Recurrence {
        <<enumeration>>
        DAILY
        WEEKLY
        MONTHLY
    }

    Owner "1" o-- "0..*" Pet : owns
    Owner ..> Scheduler : uses
    Scheduler "1" o-- "0..*" Task : manages
    Task "0..*" --> "1" Pet : targets
    Task ..> Priority
    Task ..> TaskType
    Task ..> Recurrence
    Pet ..> TaskType
```
